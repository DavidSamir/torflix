<?xml version="1.0" encoding="utf-8"?>
<!--
  The media server lives on the LAN and normally speaks plain HTTP. Cleartext is therefore
  permitted only for private (RFC-1918 / link-local / loopback) address space; everything else
  must be HTTPS. See plan.md §2.3.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- User-installed CAs allow a self-signed server certificate to be trusted after
                 the user explicitly installs it in Fire OS settings. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">169.254.0.0/16</domain>
        <domain includeSubdomains="true">.local</domain>
        <domain includeSubdomains="true">.lan</domain>
        <domain includeSubdomains="true">.home</domain>
    </domain-config>
</network-security-config>
